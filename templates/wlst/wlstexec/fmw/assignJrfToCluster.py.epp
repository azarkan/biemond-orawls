<%- |  String $weblogic_user = 'weblogic',
       String $weblogic_password,
       String $adminserver_address = 'localhost',
       Integer $adminserver_port = 7001,
       Boolean $use_t3s = false,
       String $weblogic_home_dir,
       String $domain_dir,
       String $jrf_target_name,
       String $opss_datasource_name | -%>

wlsUser = '<%= $weblogic_user %>'
password = '<%= $weblogic_password %>'
machine = '<%= $adminserver_address %>'
portNumber = '<%= $adminserver_port %>'
useT3s = '<%= $use_t3s %>'

WLHOME='<%= $weblogic_home_dir %>'
DOMAIN_PATH='<%= $domain_dir %>'
JRFTargetName = '<%= $jrf_target_name %>'
OPSSDatasourceName ='<%= $opss_datasource_name %>'

DOMAIN_PATH='<%= $domain_dir %>'

if useT3s == 'false':
   connectStr = 't3://'
else:
   connectStr = 't3s://'

connect(wlsUser, password, connectStr + machine + ':' + portNumber)

applyJRF(JRFTargetName, DOMAIN_PATH, true)
